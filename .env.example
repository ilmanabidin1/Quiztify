# ==============================================================================
# Quiztify.id Environment Configuration
# ==============================================================================

PORT=3000

# DeepSeek AI API Configuration (DeepSeek V4.1 Flash)
# Dapatkan API Key di https://platform.deepseek.com/
# Anda dapat menggunakan nama 'DEEPSEEK_API_KEY' atau 'deepseek_api_key' di Railway
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Model Identifier untuk DeepSeek V4.1 Flash (default: deepseek-flash)
# Opsi resmi: deepseek-flash, deepseek-chat, deepseek-reasoner
DEEPSEEK_MODEL=deepseek-flash

# DOKU Checkout non-SNAP. Gunakan kredensial dari environment yang sama.
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# URL publik untuk callback dan HTTP Notification (HTTPS wajib di production).
PUBLIC_BASE_URL=https://www.quiztify.id
